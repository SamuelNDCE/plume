{
  "name": "plume",
  "version": "0.5.4",
  "description": "Plume",
  "license": "MIT",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "app": "electron .",
    "build": "vite build",
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "vite": "^8.3.3"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@milkdown/crepe": "^7.0.0",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.17",
    "electron-updater": "^6.8.9",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "mermaid": "^12.1.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "read-excel-file": "^9.3.14"
  },
  "build": {
    "appId": "dev.plume.app",
    "productName": "Plume",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "build/icon.png",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": "md",
        "name": "Markdown document",
        "role": "Editor"
      },
      {
        "ext": "markdown",
        "name": "Markdown document",
        "role": "Editor"
      },
      {
        "ext": "mdown",
        "name": "Markdown document",
        "role": "Editor"
      },
      {
        "ext": "mkd",
        "name": "Markdown document",
        "role": "Editor"
      },
      {
        "ext": "txt",
        "name": "Text document",
        "role": "Editor"
      },
      {
        "ext": "log",
        "name": "Text document",
        "role": "Editor"
      },
      {
        "ext": "out",
        "name": "Text document",
        "role": "Editor"
      },
      {
        "ext": "err",
        "name": "Text document",
        "role": "Editor"
      },
      {
        "ext": "csv",
        "name": "Text document",
        "role": "Editor"
      },
      {
        "ext": "tsv",
        "name": "Text document",
        "role": "Editor"
      },
      {
        "ext": "json",
        "name": "Text document",
        "role": "Editor"
      },
      {
        "ext": "jsonl",
        "name": "Text document",
        "role": "Editor"
      },
      {
        "ext": "yaml",
        "name": "Text document",
        "role": "Editor"
      },
      {
        "ext": "yml",
        "name": "Text document",
        "role": "Editor"
      },
      {
        "ext": "xml",
        "name": "Text document",
        "role": "Editor"
      },
      {
        "ext": "toml",
        "name": "Text document",
        "role": "Editor"
      },
      {
        "ext": "ini",
        "name": "Text document",
        "role": "Editor"
      },
      {
        "ext": "cfg",
        "name": "Text document",
        "role": "Editor"
      },
      {
        "ext": "conf",
        "name": "Text document",
        "role": "Editor"
      },
      {
        "ext": "env",
        "name": "Text document",
        "role": "Editor"
      },
      {
        "ext": "properties",
        "name": "Text document",
        "role": "Editor"
      },
      {
        "ext": "sql",
        "name": "Text document",
        "role": "Editor"
      },
      {
        "ext": "diff",
        "name": "Text document",
        "role": "Editor"
      },
      {
        "ext": "patch",
        "name": "Text document",
        "role": "Editor"
      },
      {
        "ext": "ps1",
        "name": "Text document",
        "role": "Editor"
      },
      {
        "ext": "sh",
        "name": "Text document",
        "role": "Editor"
      },
      {
        "ext": "bat",
        "name": "Text document",
        "role": "Editor"
      },
      {
        "ext": "cmd",
        "name": "Text document",
        "role": "Editor"
      },
      {
        "ext": "js",
        "name": "Text document",
        "role": "Editor"
      },
      {
        "ext": "ts",
        "name": "Text document",
        "role": "Editor"
      },
      {
        "ext": "py",
        "name": "Text document",
        "role": "Editor"
      },
      {
        "ext": "html",
        "name": "Text document",
        "role": "Editor"
      },
      {
        "ext": "css",
        "name": "Text document",
        "role": "Editor"
      },
      {
        "ext": "gitignore",
        "name": "Text document",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "Plume-${version}-${os}-${arch}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "artifactName": "Plume-${version}-${os}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "artifactName": "Plume-${version}-${os}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh",
      "artifactName": "Plume-${version}-win-x64-setup.${ext}"
    },
    "portable": {
      "artifactName": "Plume-${version}-win-x64-portable.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "SamuelNDCE",
        "repo": "plume",
        "releaseType": "release"
      }
    ]
  },
  "author": "Samuel <samuelndce@gmail.com>",
  "homepage": "https://github.com/SamuelNDCE/plume",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SamuelNDCE/plume.git"
  },
  "bugs": {
    "url": "https://github.com/SamuelNDCE/plume/issues"
  },
  "keywords": [
    "markdown",
    "editor",
    "viewer",
    "wysiwyg",
    "mermaid",
    "electron",
    "open-source"
  ],
  "overrides": {
    "katex": "^0.18.10"
  }
}
