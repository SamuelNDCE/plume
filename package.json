{
  "name": "plume",
  "version": "0.1.0",
  "description": "Plume: a free, open-source, fast viewer and editor for Markdown and plain text",
  "license": "MIT",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "app": "electron .",
    "build": "vite build",
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@milkdown/crepe": "^7.0.0",
    "codemirror": "^6.0.2",
    "mermaid": "^11.0.0"
  },
  "build": {
    "appId": "dev.plume.app",
    "productName": "Plume",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdown",
          "mkd"
        ],
        "name": "Markdown document",
        "role": "Editor"
      },
      {
        "ext": [
          "txt",
          "csv",
          "tsv",
          "json",
          "log"
        ],
        "name": "Text document",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "Plume-${version}-${os}-${arch}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "artifactName": "Plume-${version}-${os}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "artifactName": "Plume-${version}-${os}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "author": "Samuel <samuelndce@gmail.com>",
  "homepage": "https://github.com/SamuelNDCE/plume",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SamuelNDCE/plume.git"
  },
  "bugs": {
    "url": "https://github.com/SamuelNDCE/plume/issues"
  },
  "keywords": [
    "markdown",
    "editor",
    "viewer",
    "wysiwyg",
    "mermaid",
    "electron",
    "open-source"
  ]
}